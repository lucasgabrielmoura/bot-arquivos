# Copie para .env e preencha. NUNCA envie o .env para o git.

# Token do @BotFather
BOT_TOKEN=

# Vazio = qualquer pessoa pode usar o bot.
# Para restringir: IDs separados por virgula (descubra com /meuid no bot)
ALLOWED_USERS=

# Pasta temporaria dos arquivos (apagada a cada uso)
WORK_DIR=./tmp_trabalho

# Conversoes ao mesmo tempo (celular fraco: 1)
MAX_JOBS=1

# Opcional: servidor Bot API local (libera arquivos ate 2GB). Deixe vazio.
TELEGRAM_API_URL=
